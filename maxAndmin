#include<iostream>
using namespace std;
void computePerformance(int arr[], int size);
int main()
{
 int arr[10];
 cout<<"enter the 10 marks="<<endl;
 for(int i=0;i<=10;i++)
 {
    cin>>arr[i];
 }
 computePerformance(arr,10);
}
void computePerformance(int arr[],int size)
{
 int min=arr[0],max=arr[0];
 float avg=arr[0];
 for(int i=1;i<=size;i++)
 {
   if(max<arr[i])
   {
    max=arr[i];
   }
   if(min>arr[i])
   {
    min=arr[i];
   }
   avg+=arr[i];
 }
cout<<"the average is="<<avg/size<<endl;
cout<<"the min value="<<min<<endl;
cout<<"the max value="<<max<<endl;

}
