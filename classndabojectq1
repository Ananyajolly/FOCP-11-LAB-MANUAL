#include<iostream>
using namespace std;
class Student
{
 string name;
 int marks;
 public:
 Student();
 Student(string,int);
 void member_display();
};
Student::Student()
{
    name="";
    marks=0;
}
Student::Student(string name1,int numb)
{
 name=name1;
 marks=numb;
}
void Student::member_display()
{
 cout<<"the name of the student="<<name<<endl;
 cout<<"the marks of the student="<<marks<<endl;
}
int main()
{
 Student s1;
 Student s2("Ananya",99);
 s1.member_display();
 s2.member_display();

}
