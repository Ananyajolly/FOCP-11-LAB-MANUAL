#include<iostream>
using namespace std;
void swap(int *x,int *y);
int main()
{
 int a,b;
 cout<<"enter the value of a and b"<<endl;
 cin>>a;
 cin>>b;
 swap(&a,&b);
 cout<<"after the swap a="<<a<<" b="<<b<<endl;
}
void swap(int *x,int *y)
{
 *x=*x+*y;
 *y=*x-*y;
 *x=*x-*y;
 cout<<"value inside the fuction a="<<*x<<" b="<<*y<<endl;
}
